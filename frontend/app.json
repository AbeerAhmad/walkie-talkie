{
  "expo": {
    "name": "Walkie Talkie",
    "slug": "walkie-talkie-app",
    "version": "1.0.0",
    "android": {
      "package": "com.abeer.walkietalkie",
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "com.abeer.walkietalkie",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for walkie talkie audio."
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a1a2e",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  
    
  }
}
